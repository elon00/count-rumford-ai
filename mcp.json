{
  "mcpServers": {
    "count-rumford-ai": {
      "command": "cargo",
      "args": [
        "run",
        "--release",
        "--quiet"
      ],
      "env": {
        "RUST_LOG": "info",
        "TITAN_PROTOCOL": "RUMFORD",
        "TARGET_CHAIN": "Sui",
        "FIPS_203_LEVEL": "ML-KEM-768",
        "FIPS_204_LEVEL": "ML-DSA-65"
      },
      "tools": [
        {
          "name": "calculate_friction_mechanical_heat",
          "description": "Quantifies infinite heat generated by blunt cannon boring tool without loss of metallic mass",
          "parameters": {
            "type": "object",
            "properties": {
              "boring_torque_nm": {
                "type": "number"
              },
              "rotations": {
                "type": "integer"
              }
            },
            "required": [
              "boring_torque_nm"
            ]
          }
        },
        {
          "name": "measure_photometric_standard_candle",
          "description": "Computes luminous intensity and radiation efficiency in Rumford shadow photometer",
          "parameters": {
            "type": "object",
            "properties": {
              "candlepower": {
                "type": "number"
              },
              "distance_m": {
                "type": "number"
              }
            },
            "required": [
              "candlepower"
            ]
          }
        }
      ]
    }
  }
}